{
  "name": "happy-codec",
  "description": "Zero-dependency codec library for Base64, Hex, UTF-8 and ByteString encoding/decoding.",
  "author": "jiang115jie@gmail.com",
  "license": "MIT",
  "version": "1.2.2",
  "type": "module",
  "main": "dist/main.cjs",
  "module": "dist/main.mjs",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs",
      "default": "./dist/main.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "pnpm exec tsc --noEmit",
    "lint": "pnpm exec eslint .",
    "prebuild": "pnpm run check && pnpm run lint",
    "build": "pnpm exec vite build",
    "prepublishOnly": "pnpm run build",
    "docs": "pnpm exec typedoc",
    "test": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest watch",
    "test:ui": "pnpm exec vitest --ui",
    "bench": "pnpm exec vitest bench --run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiangJie/happy-codec.git"
  },
  "keywords": [
    "codec",
    "encoding",
    "decoding",
    "encoder",
    "decoder",
    "base64",
    "base64url",
    "hex",
    "utf8",
    "utf-8",
    "bytestring",
    "binary",
    "buffer",
    "arraybuffer",
    "uint8array",
    "sharedarraybuffer",
    "text-encoder",
    "text-decoder",
    "zero-dependency",
    "polyfill"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
